---
interface Props {
  prevProject?: { title: string; slug: string };
  nextProject?: { title: string; slug: string };
}

const { prevProject, nextProject } = Astro.props;

const navItems = [
  { label: 'CV', href: '/narrative/' },
  { label: 'Creative', href: '/creative/' },
  { label: 'Inquiry', href: '/inquiry/' },
  { label: 'Strategy', href: '/strategy/' },
];
---

<nav class="fixed top-0 w-full z-40 glass mix-blend-difference text-gray-300">
  <!-- Mobile -->
  <div class="md:hidden w-full px-6 py-5">
    <div class="flex justify-between items-center">
      <a href="/" class="font-serif text-2xl tracking-tight font-semibold text-white hover:text-glow transition-all duration-300">
        Todd Margolis
      </a>
      <div class="flex items-center gap-4">
        {navItems.map((item) => (
          <a href={item.href} class="font-mono text-xs tracking-[0.2em] uppercase font-normal hover:text-white hover:text-glow transition-all duration-300">{item.label}</a>
        ))}
        <!-- Project Nav Arrows (Mobile - when on project page) -->
        {prevProject && nextProject && (
          <div class="flex gap-3 font-mono text-xs">
            <a href={`/works/${prevProject.slug}/`} class="hover:text-white hover:text-glow transition-all duration-300">&larr;</a>
            <a href={`/works/${nextProject.slug}/`} class="hover:text-white hover:text-glow transition-all duration-300">&rarr;</a>
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- Desktop -->
  <div class="hidden md:flex w-full justify-between items-center px-8 py-5">
    <a href="/" class="font-serif text-2xl tracking-tight font-semibold text-white hover:text-glow transition-all duration-300">
      Todd Margolis
    </a>

    <!-- Center: Project Nav (when on project page) -->
    {prevProject && nextProject ? (
      <div class="flex gap-8 font-mono text-xs tracking-[0.2em] uppercase absolute left-1/2 transform -translate-x-1/2">
        <a href={`/works/${prevProject.slug}/`} class="font-normal hover:text-white hover:text-glow transition-all duration-300 group">
          &larr; <span class="hidden xl:inline">{prevProject.title}</span>
        </a>
        <span class="text-white/20">|</span>
        <a href={`/works/${nextProject.slug}/`} class="font-normal hover:text-white hover:text-glow transition-all duration-300 group">
          <span class="hidden xl:inline">{nextProject.title}</span> &rarr;
        </a>
      </div>
    ) : (
      <div class="absolute left-1/2 transform -translate-x-1/2 flex gap-8 font-mono text-xs tracking-[0.2em] uppercase">
        {navItems.map((item) => (
          <a href={item.href} class="font-normal hover:text-white hover:text-glow transition-all duration-300">{item.label}</a>
        ))}
      </div>
    )}

    <!-- Right: spacer for balance -->
    <div class="w-[140px]" aria-hidden="true"></div>
  </div>
</nav>
