---
const navItems = [
  { label: 'CV', href: '/narrative/' },
  { label: 'Creative', href: '/creative/' },
  { label: 'Inquiry', href: '/inquiry/' },
  { label: 'Strategy', href: '/strategy/' },
];
---

<nav class="fixed top-0 w-full z-40 glass mix-blend-difference text-gray-300">
  <!-- Mobile -->
  <div class="md:hidden w-full px-6 py-5">
    <div class="flex justify-between items-center">
      <a href="/" class="font-serif text-2xl tracking-tight font-semibold text-white hover:text-glow transition-all duration-300">
        Todd Margolis
      </a>
      <div class="flex items-center gap-4">
        {navItems.map((item) => (
          <a href={item.href} class="font-mono text-xs tracking-[0.2em] uppercase font-normal hover:text-white hover:text-glow transition-all duration-300">{item.label}</a>
        ))}
      </div>
    </div>
  </div>

  <!-- Desktop -->
  <div class="hidden md:flex w-full justify-between items-center px-8 py-5">
    <a href="/" class="font-serif text-2xl tracking-tight font-semibold text-white hover:text-glow transition-all duration-300">
      Todd Margolis
    </a>

    <div class="absolute left-1/2 transform -translate-x-1/2 flex gap-8 font-mono text-xs tracking-[0.2em] uppercase">
      {navItems.map((item) => (
        <a href={item.href} class="font-normal hover:text-white hover:text-glow transition-all duration-300">{item.label}</a>
      ))}
    </div>

    <!-- Right: spacer for balance -->
    <div class="w-[140px]" aria-hidden="true"></div>
  </div>
</nav>
