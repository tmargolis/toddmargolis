---
interface Props {
  activeCategories?: string[];
}
const { activeCategories = [] } = Astro.props;

function subCategorySlug(name: string): string {
  return name
    .replace(/\s*&\s*/g, '-and-')
    .toLowerCase()
    .replace(/\s+/g, '-')
    .replace(/&/g, '-and-')
    .replace(/[^a-z0-9-]/g, '')
    .replace(/-+/g, '-')
    .replace(/^-|-$/g, '');
}

const navItems = [
  {
    label: 'Research',
    href: '/research/',
    subCategories: [
      'Display & Interaction Systems',
      'Collaborative Environments',
      'Publications & Theory',
      'Pedagogy & Labs',
    ],
  },
  {
    label: 'Strategy',
    href: '/strategy/',
    subCategories: [
      'R&D Leadership',
      'Academic Practice',
      'Cultural Stewardship',
    ],
  },
  {
    label: 'Creative',
    href: '/creative/',
    subCategories: [
      'Tangible Artifacts',
      'Immersive Installations',
      'Augmented Interventions',
      'Performative Systems',
    ],
  }
];
---

<nav id="site-header" class="fixed top-0 w-full z-40 bg-black/10 backdrop-blur-md border-b border-white/10 text-gray-300">
  <!-- Mobile -->
  <div class="md:hidden w-full px-6 pt-4 pb-0">
    <!-- Row 1: Name + Search icon -->
    <div class="flex justify-between items-center mb-2">
      <a href="/" class="font-serif tracking-tight font-semibold text-gray hover:text-glow transition-all duration-300">
        Todd Margolis
      </a>
      <a href="https://toddmargolis.net/works/" aria-label="Search works" class="hover:text-white hover:text-glow transition-all duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </a>
    </div>
    <!-- Row 2: Nav links with accordion subcategories -->
    <div class="flex flex-col gap-0 font-mono text-xs tracking-[0.2em] uppercase">
      {navItems.map((item, i) => {
        const isActive = activeCategories.includes(item.label);
        const hasSubs = item.subCategories?.length;
        return (
          <div class="mobile-nav-accordion border-b border-white/5 last:border-b-0" data-nav-index={i}>
            <div class="flex items-center justify-between py-0.5 -mx-1">
              <a href={item.href} class={`hover:text-white hover:text-glow transition-all duration-300 flex-grow ${isActive ? 'font-semibold' : 'font-normal'}`}>{item.label}</a>
              {hasSubs ? (
                <button
                  type="button"
                  class="mobile-nav-toggle p-3 -m-2 hover:text-white hover:text-glow transition-all duration-300 [&[aria-expanded=true]_svg]:rotate-180 min-w-[44px] min-h-[44px] flex items-center justify-center"
                  aria-expanded="false"
                  aria-controls={`mobile-nav-panel-${i}`}
                  id={`mobile-nav-trigger-${i}`}
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200">
                    <polyline points="6 9 12 15 18 9"/>
                  </svg>
                </button>
              ) : null}
            </div>
            {hasSubs ? (
              <div id={`mobile-nav-panel-${i}`} class="mobile-nav-panel hidden flex flex-col pb-2 pl-2 text-[0.65rem] tracking-[0.15em]" role="region" aria-labelledby={`mobile-nav-trigger-${i}`}>
                {item.subCategories!.map((name) => (
                  <a
                    href={`${item.href}#${subCategorySlug(name)}`}
                    class="block py-1.5 font-normal text-gray-400 hover:text-white hover:text-glow transition-all duration-200"
                  >
                    {name}
                  </a>
                ))}
              </div>
            ) : null}
          </div>
        );
      })}
    </div>
  </div>

  <script>
    function setHeaderHeight() {
      const nav = document.getElementById('site-header');
      if (nav && window.matchMedia('(max-width: 767px)').matches) {
        document.documentElement.style.setProperty('--header-height', `${nav.offsetHeight}px`);
      }
    }
    setHeaderHeight();
    window.addEventListener('resize', setHeaderHeight);
    document.querySelectorAll('.mobile-nav-toggle').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const panel = document.getElementById(btn.getAttribute('aria-controls')!);
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
        const allPanels = document.querySelectorAll('.mobile-nav-panel');
        const allToggles = document.querySelectorAll('.mobile-nav-toggle');
        if (!isExpanded) {
          allToggles.forEach((t) => t.setAttribute('aria-expanded', 'false'));
          allPanels.forEach((p) => p.classList.add('hidden'));
          btn.setAttribute('aria-expanded', 'true');
          panel?.classList.remove('hidden');
        } else {
          btn.setAttribute('aria-expanded', 'false');
          panel?.classList.add('hidden');
        }
        requestAnimationFrame(setHeaderHeight);
      });
    });
  </script>

  <!-- Desktop -->
  <div class="hidden md:flex w-full justify-between items-center px-8 py-1">
    <a href="/" class="font-serif text-lg tracking-tight font-semibold text-gray hover:text-glow transition-all duration-300">
      Todd Margolis
    </a>

    <div class="absolute left-1/2 transform -translate-x-1/2 flex gap-8 font-mono text-xs tracking-[0.2em] uppercase">
      {navItems.map((item) => {
        const isActive = activeCategories.includes(item.label);
        return 'subCategories' in item && item.subCategories?.length ? (
          <div class="relative group">
            <a href={item.href} class={`${isActive ? 'font-semibold' : 'font-normal'} hover:text-white hover:text-glow transition-all duration-300 block py-1`}>{item.label}</a>
            <div class="absolute left-0 top-full pt-1 z-50 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
              <div class="bg-[#0a0a0a] border border-white/10 rounded shadow-2xl py-1 min-w-[325px]">
                {item.subCategories.map((name) => (
                  <a
                    href={`${item.href}#${subCategorySlug(name)}`}
                    class="block px-4 py-1 font-normal text-gray-300 hover:text-white hover:text-glow hover:bg-white/5 transition-all duration-200 first:pt-2 last:pb-2"
                  >
                    {name}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a href={item.href} class={`${isActive ? 'font-semibold' : 'font-normal'} hover:text-white hover:text-glow transition-all duration-300`}>{item.label}</a>
        );
      })}
    </div>

    <!-- Right: search icon -->
    <div class="w-[140px] flex justify-end">
      <a href="https://toddmargolis.net/works/" aria-label="Search works" class="hover:text-white hover:text-glow transition-all duration-300">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </a>
    </div>
  </div>
</nav>