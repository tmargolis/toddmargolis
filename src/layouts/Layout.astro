---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
  fullTitle?: string;
  hideFooter?: boolean;
  activeCategories?: string[];
}

const { title, fullTitle, hideFooter = false, activeCategories = [] } = Astro.props;
const documentTitle = fullTitle ?? `Todd Margolis | ${title}`;
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-obs-black text-gray-200">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Todd Margolis" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
		<link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{documentTitle}</title>
		
		<!-- Open Graph / Social Media Preview -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={documentTitle} />
		<meta property="og:description" content="Todd Margolis" />
		<meta property="og:image" content={`${Astro.site}/images/og-image.jpg`} />
		<meta property="og:url" content={`${Astro.site}${Astro.url.pathname}`} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={`${Astro.site}/images/og-image.jpg`} />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

    <!-- Umami analytics -->
    <script defer src="https://cloud.umami.is/script.js" data-website-id="2fdb18fd-4cf4-4b2e-b12d-6b0594c3d009"></script>
    </head>
	<body class="relative min-h-screen flex flex-col">
    
    <!-- Noise Texture -->
    <div class="noise-overlay"></div>

    <Header activeCategories={activeCategories} />
    
    <main class="relative z-10 pt-[var(--header-height,4.5rem)] md:pt-12 min-h-0 flex-1 flex flex-col">
		  <slot />
    </main>

    {!hideFooter && <Footer />}
	</body>
</html>
