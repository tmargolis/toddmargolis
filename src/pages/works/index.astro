---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';

/** Parse year string to a numeric sort key (higher = more recent). */
function sortYearFromYearString(yearStr: string): number {
  if (!yearStr) return 0;
  const s = yearStr.toLowerCase();
  if (s.includes('present')) return 2030;
  const fourDigit = [...yearStr.matchAll(/\b(19|20)\d{2}\b/g)].map((m) => parseInt(m[0], 10));
  if (fourDigit.length) return Math.max(...fourDigit);
  const twoDigit = [...yearStr.matchAll(/\b(\d{2})\b/g)].map((m) => {
    const n = parseInt(m[1], 10);
    return n <= 50 ? 2000 + n : 1900 + n;
  });
  if (twoDigit.length) return Math.max(...twoDigit);
  return 0;
}

const projectsByDate = [...projects].sort(
  (a, b) => sortYearFromYearString(b.year) - sortYearFromYearString(a.year)
);

/** Use first image when no specific hero image is set (placeholder or empty). */
function getDisplayHeroImage(project: (typeof projects)[0]) {
  return (project.heroImage === '/images/placeholder.png' || !project.heroImage?.trim()) && project.images?.length > 0
    ? project.images[0]
    : project.heroImage ?? '';
}

// Get all unique tags from projects and count them
const allTags = new Set<string>();
const tagCounts: Record<string, number> = {};
projects.forEach(project => {
  project.projectTag?.forEach(tag => {
    allTags.add(tag);
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});

// Organize tags into groups
const outcomeTags = ['prototype', 'product', 'research', 'installation', 'artifact'];
const processTags = ['0-to-1', 'hands-on', 'leadership', 'strategy', 'cross-functional'];
const domainTags = ['AI-ML', 'spatial', 'data-viz', 'interaction', 'infrastructure', 'astronomy'];
---

<Layout
  title="Works"
  description="Portfolio of creative, research, and strategy work by Todd Margolis — immersive installations, data visualization, virtual reality, AI and more."
  canonical="https://toddmargolis.net/works/"
>
  <!-- Full-bleed background video -->
  <div class="fixed inset-0 z-0 overflow-hidden" aria-hidden="true">
    <video
      id="works-bg-video"
      class="absolute inset-0 w-full h-full object-cover object-right md:object-center"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster="/video/wildcat-poster.jpg"
    >
      <source src="/video/wildcat.mp4" type="video/mp4" />
      <source src="/video/wildcat.webm" type="video/webm" />
    </video>
  </div>
  <script>
    (function() {
      var video = document.getElementById('works-bg-video');
      if (!video) return;
      function tryPlay() {
        video.muted = true;
        video.play().catch(function() {});
      }
      tryPlay();
      if (document.visibilityState === 'hidden') {
        document.addEventListener('visibilitychange', function onVisible() {
          if (document.visibilityState === 'visible') {
            tryPlay();
            document.removeEventListener('visibilitychange', onVisible);
          }
        });
      }
    })();
  </script>

  <div class="relative z-10">
  <section class="pt-32 pb-24 px-6 md:px-12 max-w-7xl mx-auto">
      <h1 class="font-serif text-5xl md:text-7xl mb-6 text-center">Explore</h1>

      <!-- Search + Tag Filter (dark card like header/footer) -->
      <div class="mb-12 bg-black/10 backdrop-blur-md border border-white/10 rounded-lg px-6 py-6 md:px-8 md:py-8">
      <!-- Search Box -->
      <div class="mb-8 max-w-xl mx-auto">
        <div class="relative">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 pointer-events-none" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input
            id="search-input"
            type="text"
            placeholder="Search by title, description, medium…"
            class="w-full bg-transparent border border-white/20 font-mono text-sm text-gray-300 placeholder-gray-600 pl-9 pr-4 py-2 focus:outline-none focus:border-white/50 transition-colors"
          />
          <button id="clear-search" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-600 hover:text-white transition-colors hidden" aria-label="Clear search">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Tag Filter UI -->
      <div class="space-y-6">
        
        <!-- Outcome Tags -->
        <div class="border-l border-white/20 pl-4">
          <h3 class="font-mono text-xs text-gray-500 uppercase tracking-widest mb-3">What I Built</h3>
          <div class="flex flex-wrap gap-2">
            {outcomeTags.filter(tag => allTags.has(tag)).map(tag => (
              <button 
                class="tag-button font-mono text-xs px-3 py-1 border border-white/20 hover:bg-white/10 transition-colors"
                data-tag={tag}
              >
                #{tag} <span class="text-gray-500">({tagCounts[tag] || 0})</span>
              </button>
            ))}
          </div>
        </div>

        <!-- Process Tags -->
        <div class="border-l border-white/20 pl-4">
          <h3 class="font-mono text-xs text-gray-500 uppercase tracking-widest mb-3">How I Work</h3>
          <div class="flex flex-wrap gap-2">
            {processTags.filter(tag => allTags.has(tag)).map(tag => (
              <button 
                class="tag-button font-mono text-xs px-3 py-1 border border-white/20 hover:bg-white/10 transition-colors"
                data-tag={tag}
              >
                #{tag} <span class="text-gray-500">({tagCounts[tag] || 0})</span>
              </button>
            ))}
          </div>
        </div>

        <!-- Domain Tags -->
        <div class="border-l border-white/20 pl-4">
          <h3 class="font-mono text-xs text-gray-500 uppercase tracking-widest mb-3">Domain</h3>
          <div class="flex flex-wrap gap-2">
            {domainTags.filter(tag => allTags.has(tag)).map(tag => (
              <button 
                class="tag-button font-mono text-xs px-3 py-1 border border-white/20 hover:bg-white/10 transition-colors"
                data-tag={tag}
              >
                #{tag} <span class="text-gray-500">({tagCounts[tag] || 0})</span>
              </button>
            ))}
          </div>
        </div>

        <!-- Clear button -->
        <div class="text-center">
          <button 
            id="clear-tags" 
            class="font-mono text-xs text-gray-500 hover:text-white underline hidden"
          >
            Clear all filters
          </button>
        </div>
      </div>
      </div>

      <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 gap-12">
        {projectsByDate.map((project, index) => (
          <article 
            class="project-card"
            data-tags={project.projectTag?.join(',') || ''}
            data-title={project.title?.toLowerCase() || ''}
            data-description={project.description?.toLowerCase() || ''}
            data-medium={project.medium?.toLowerCase() || ''}
            data-year={project.year?.toLowerCase() || ''}
          >
            <a href={`/works/${project.slug}/`} class="group block relative">
               <div class="aspect-[4/3] bg-gray-900 w-full overflow-hidden mb-1 relative">
                  <div class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition-colors z-10"></div>
                  <img 
                    src={getDisplayHeroImage(project)} 
                    alt={project.title} 
                    class="object-cover w-full h-full md:grayscale md:group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700 ease-out"
                    loading="lazy"
                  />
               </div>
               <div class="flex justify-between items-start bg-black/10 backdrop-blur-md border border-white/10 rounded-b px-4 py-3 -mt-px">
                 <div>
                    <h4 class="font-serif text-2xl text-white group-hover:text-glow transition-all">{project.title}</h4>
                    <p class="font-mono text-xs text-gray-500 mt-1 uppercase">{project.year} | {project.medium}</p>
                 </div>
                 <span class="project-number font-mono text-xs text-indigo-400 tracking-widest">0{index + 1}</span>
               </div>
            </a>
          </article>
        ))}
      </div>

  </section>
  </div>
</Layout>

<script>
  // Tag filtering logic
  const activeTags = new Set<string>();
  const tagButtons = document.querySelectorAll('.tag-button');
  const projectCards = document.querySelectorAll('.project-card');
  const clearTagsButton = document.getElementById('clear-tags');
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const clearSearchButton = document.getElementById('clear-search');

  let searchQuery = '';

  function activateTag(tag: string) {
    activeTags.add(tag);
    tagButtons.forEach(button => {
      if (button.getAttribute('data-tag') === tag) {
        button.classList.add('bg-white', 'text-black');
        button.classList.remove('border-white/20');
      }
    });
  }

  function syncHashToTags() {
    const hashTag = window.location.hash.match(/^#tag-(.+)$/);
    if (hashTag) {
      activateTag(hashTag[1]);
      return;
    }
    // Legacy ?tag= URLs — migrate to hash without reload
    const urlTag = new URLSearchParams(window.location.search).get('tag');
    if (urlTag) {
      activateTag(urlTag);
      history.replaceState(null, '', `/works/#tag-${urlTag}`);
    }
  }

  syncHashToTags();

  window.addEventListener('hashchange', () => {
    activeTags.clear();
    tagButtons.forEach(button => {
      button.classList.remove('bg-white', 'text-black');
      button.classList.add('border-white/20');
    });
    syncHashToTags();
    updateDisplay();
  });

  function updateDisplay() {
    let visibleIndex = 0;

    projectCards.forEach(card => {
      const cardTags = (card.getAttribute('data-tags') || '').split(',').filter(Boolean);
      const title = card.getAttribute('data-title') || '';
      const description = card.getAttribute('data-description') || '';
      const medium = card.getAttribute('data-medium') || '';
      const year = card.getAttribute('data-year') || '';
      const allText = `${title} ${description} ${medium} ${year} ${cardTags.join(' ')}`;

      const tagMatch = activeTags.size === 0 || cardTags.some(tag => activeTags.has(tag));
      const searchMatch = searchQuery === '' || allText.includes(searchQuery);

      if (tagMatch && searchMatch) {
        card.classList.remove('hidden');
        visibleIndex++;
        const numberSpan = card.querySelector('.project-number');
        if (numberSpan) {
          numberSpan.textContent = visibleIndex < 10 ? `0${visibleIndex}` : `${visibleIndex}`;
        }
      } else {
        card.classList.add('hidden');
      }
    });

    // Show/hide clear tags button
    if (clearTagsButton) {
      clearTagsButton.classList.toggle('hidden', activeTags.size === 0);
    }
  }

  // Search input handler
  if (searchInput) {
    searchInput.addEventListener('input', () => {
      searchQuery = searchInput.value.toLowerCase().trim();
      if (clearSearchButton) {
        clearSearchButton.classList.toggle('hidden', searchQuery === '');
      }
      updateDisplay();
    });
  }

  // Clear search button
  if (clearSearchButton) {
    clearSearchButton.addEventListener('click', () => {
      searchInput.value = '';
      searchQuery = '';
      clearSearchButton.classList.add('hidden');
      updateDisplay();
    });
  }

  // Tag button click handlers
  tagButtons.forEach(button => {
    button.addEventListener('click', () => {
      const tag = button.getAttribute('data-tag');
      if (!tag) return;

      if (activeTags.has(tag)) {
        activeTags.delete(tag);
        button.classList.remove('bg-white', 'text-black');
        button.classList.add('border-white/20');
      } else {
        activeTags.add(tag);
        button.classList.add('bg-white', 'text-black');
        button.classList.remove('border-white/20');
      }

      const hash = activeTags.size === 1 ? `#tag-${[...activeTags][0]}` : '';
      history.replaceState(null, '', `/works/${hash}`);
      updateDisplay();
    });
  });

  // Clear tags button handler
  if (clearTagsButton) {
    clearTagsButton.addEventListener('click', () => {
      activeTags.clear();
      tagButtons.forEach(button => {
        button.classList.remove('bg-white', 'text-black');
        button.classList.add('border-white/20');
      });
      history.replaceState(null, '', '/works/');
      updateDisplay();
    });
  }

  // Initial display update (for URL parameter)
  updateDisplay();
</script>