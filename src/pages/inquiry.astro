---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';

const categoryProjects = projects.filter((p) => p.category.includes('Inquiry'));

const inquirySubCategoryOrder = [
  'Display & Interaction Systems',
  'Collaborative Environments',
  'Publications & Theory',
  'Pedagogy & Labs',
];

const projectsBySubCategory = inquirySubCategoryOrder.map((subCat) => ({
  name: subCat,
  slug: subCat.replace(/\s*&\s*/g, '-and-').toLowerCase().replace(/\s+/g, '-').replace(/&/g, '-and-').replace(/[^a-z0-9-]/g, '').replace(/-+/g, '-').replace(/^-|-$/g, ''),
  projects: categoryProjects.filter(
    (p) => p.subCategory && p.subCategory.includes(subCat)
  ),
})).filter((section) => section.projects.length > 0);
---

<Layout title="Inquiry">
  <section class="pt-32 pb-24 px-6 md:px-12 max-w-7xl mx-auto">
    <h1 class="font-serif text-5xl md:text-7xl mb-16 text-center">Inquiry</h1>

    {projectsBySubCategory.map(({ name, slug, projects: subProjects }) => (
      <div id={slug} class="mb-20 scroll-mt-32">
        <h2 class="font-mono text-sm uppercase text-gray-400 tracking-widest mb-8 border-b border-white/10 pb-4">
          {name}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
          {subProjects.map((project, index) => (
            <a href={`/works/${project.slug}/`} class="group block relative">
              <div class="aspect-[4/3] bg-gray-900 w-full overflow-hidden mb-6 relative">
                <div class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition-colors z-10"></div>
                <img
                  src={project.heroImage}
                  alt={project.title}
                  class="object-cover w-full h-full grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700 ease-out"
                />
              </div>
              <div class="flex justify-between items-start border-t border-white/10 pt-4">
                <div>
                  <h4 class="font-serif text-2xl text-white group-hover:text-glow transition-all">{project.title}</h4>
                  <p class="font-mono text-xs text-gray-500 mt-1 uppercase">{project.year} | {project.medium}</p>
                </div>
                <span class="font-mono text-xs text-indigo-400 tracking-widest">0{index + 1}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}

    <div class="flex justify-center mt-16">
      <a href="/works/" class="border border-white/20 text-white font-mono text-xs px-8 py-4 uppercase tracking-[0.2em] hover:bg-white hover:text-black transition-all duration-500">
        All Works
      </a>
    </div>
  </section>
</Layout>
