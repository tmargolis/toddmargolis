---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Inquire" description="Contact Todd Margolis for professional inquiries, commissions, speaking engagements, and project collaborations.">
  <div class="relative z-10">
  <section class="pt-0 pb-24 flex flex-col justify-start items-center px-6 md:px-12 text-center">
      <h1 class="font-serif text-5xl md:text-7xl mb-6">Connect</h1>
      <p class="font-mono text-sm text-gray-400 mb-6 max-w-lg">
          For all professional and project inquiries, please contact me directly.
      </p>

      <div class="space-y-8 font-mono text-sm uppercase tracking-widest">
          <div>
              <span class="block text-xs text-gray-600 mb-2">General Inquiries</span>
              <a href="mailto:info@toddmargolis.net" class="text-2xl text-white hover:text-indigo-400 transition-colors">info@toddmargolis.net</a>
          </div>

          <div>
               <span class="block text-xs text-gray-600 mb-1">LOCATION</span>
               <p class="text-white">Chicago, IL</p>
          </div>
      </div>
  </section>
  </div>

    <!-- Black background (no gradient) -->
  <div class="fixed inset-0 z-0 bg-black" aria-hidden="true"></div>
  <!-- Eclipse image positioned lower so it doesn't overlap Connect -->
  <div class="fixed inset-0 z-0 overflow-hidden" aria-hidden="true">
    <img
      src="/images/eclipse.jpg"
      alt=""
      class="absolute inset-0 w-full h-full object-contain object-[center_80%]"
    />
  </div>

</Layout>
