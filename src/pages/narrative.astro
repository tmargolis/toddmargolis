---
import Layout from '../layouts/Layout.astro';

// Published Google Doc (Todd Margolis - CV - 2026)
const CV_PUB_URL = 'https://docs.google.com/document/d/e/2PACX-1vSMRQhNCfEiPCx53vMYv2VXTi_kNsDh_Y4PlSgAKt0t9LF880Kis1SwN9dumALolQ3Vok3Ub3F4ee4P/pub';
const embedUrl = `${CV_PUB_URL}?embedded=true`;
---

<Layout title="Perspective" description="Curriculum vitae of Todd Margolis — career in immersive media, virtual reality, data visualization, and applied research.">
  <section class="pt-24 pb-24 px-6 md:px-12 w-full">
    <header class="mb-8 max-w-7xl mx-auto">
      <h1 class="font-serif text-4xl md:text-5xl text-white italic">Curriculum Vitae</h1>
    </header>

    <div class="w-full border border-white/10 rounded overflow-hidden bg-white/5 cv-embed-wrapper">
      <iframe
        src={embedUrl}
        title="Todd Margolis — Curriculum Vitae"
        class="cv-embed-iframe border-0"
        loading="lazy"
      />
    </div>

    <p class="font-mono text-[10px] text-gray-500 mt-4 text-center">
      <a href={CV_PUB_URL} target="_blank" rel="noopener noreferrer" class="hover:text-gray-400 transition-colors">
        Open in Google Docs
      </a>
    </p>
  </section>
</Layout>
