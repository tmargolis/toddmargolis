---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects';

/** Parse year string to a numeric sort key (higher = more recent). */
function sortYearFromYearString(yearStr: string): number {
  if (!yearStr) return 0;
  const s = yearStr.toLowerCase();
  if (s.includes('present')) return 2030;
  const fourDigit = [...yearStr.matchAll(/\b(19|20)\d{2}\b/g)].map((m) => parseInt(m[0], 10));
  if (fourDigit.length) return Math.max(...fourDigit);
  const twoDigit = [...yearStr.matchAll(/\b(\d{2})\b/g)].map((m) => {
    const n = parseInt(m[1], 10);
    return n <= 50 ? 2000 + n : 1900 + n;
  });
  if (twoDigit.length) return Math.max(...twoDigit);
  return 0;
}

const categoryProjects = projects.filter((p) => p.category.includes('Creative'));

const creativeSubCategoryOrder = [
  'Tangible Artifacts',
  'Immersive Installations',
  'Augmented Interventions',
  'Performative Systems',
];

const projectsBySubCategory = creativeSubCategoryOrder.map((subCat) => ({
  name: subCat,
  slug: subCat.replace(/\s*&\s*/g, '-and-').toLowerCase().replace(/\s+/g, '-').replace(/&/g, '-and-').replace(/[^a-z0-9-]/g, '').replace(/-+/g, '-').replace(/^-|-$/g, ''),
  projects: categoryProjects
    .filter((p) => p.subCategory && p.subCategory.includes(subCat))
    .sort((a, b) => sortYearFromYearString(b.year) - sortYearFromYearString(a.year)),
})).filter((section) => section.projects.length > 0);

/** Use first image when no specific hero image is set (placeholder or empty). */
function getDisplayHeroImage(project: (typeof projects)[0]) {
  return (project.heroImage === '/images/placeholder.png' || !project.heroImage?.trim()) && project.images?.length > 0
    ? project.images[0]
    : project.heroImage;
}
---

<Layout title="Creative" activeCategories={['Creative']}>
  <section class="pt-32 pb-24 px-6 md:px-12 max-w-7xl mx-auto">
    <h1 class="font-serif text-5xl md:text-7xl mb-16 text-center">Creative</h1>

    {projectsBySubCategory.map(({ name, slug, projects: subProjects }) => (
      <div id={slug} class="mb-20 scroll-mt-32">
        <h2 class="subsection-title font-mono text-sm uppercase tracking-widest">
          {name}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
          {subProjects.map((project, index) => (
            <a href={`/works/${project.slug}/`} class="group block relative">
              <div class="aspect-[4/3] bg-gray-900 w-full overflow-hidden mb-6 relative">
                <div class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition-colors z-10"></div>
                <img
                  src={getDisplayHeroImage(project)}
                  alt={project.title}
                  class="object-cover w-full h-full md:grayscale md:group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700 ease-out"
                />
              </div>
              <div class="flex justify-between items-start border-t border-white/10 pt-4">
                <div>
                  <h4 class="font-serif text-2xl text-white group-hover:text-glow transition-all">{project.title}</h4>
                  <p class="font-mono text-xs text-gray-500 mt-1 uppercase">{project.year} | {project.medium}</p>
                </div>
                <span class="font-mono text-xs text-indigo-400 tracking-widest">0{index + 1}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}

    <div class="flex justify-center mt-16">
      <a href="/works/" class="border border-white/20 text-white font-mono text-xs px-8 py-4 uppercase tracking-[0.2em] hover:bg-white hover:text-black transition-all duration-500">
        All Works
      </a>
    </div>
  </section>
</Layout>
