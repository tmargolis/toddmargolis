---
import Layout from '../layouts/Layout.astro';

const slugify = (name: string) =>
  name.replace(/\s*&\s*/g, '-and-').toLowerCase().replace(/\s+/g, '-').replace(/&/g, '-and-').replace(/[^a-z0-9-]/g, '').replace(/-+/g, '-').replace(/^-|-$/g, '');

const creativeSubCategories = [
  { name: 'Immersive Installations', page: '/creative/' },
  { name: 'Tangible Artifacts', page: '/creative/' },
  { name: 'Augmented Interventions', page: '/creative/' },
  { name: 'Performative Systems', page: '/creative/' },
];

const inquirySubCategories = [
  { name: 'Display & Interaction', page: '/inquiry/' },
  { name: 'Collaborative Environments', page: '/inquiry/' },
  { name: 'Publications & Theory', page: '/inquiry/' },
  { name: 'Pedagogy & Labs', page: '/inquiry/' },
];

const strategySubCategories = [
  { name: 'R&D Leadership', page: '/strategy/' },
  { name: 'Academic Practice', page: '/strategy/' },
  { name: 'Cultural Stewardship', page: '/strategy/' },
];
---

<Layout title="Todd Margolis" fullTitle="Home | Todd Margolis" description="Materializing the Invisible">

    <section class="mt-0 md:mt-0">
        <header class="text-center max-w-4xl mx-auto pt-12 md:pt-16">
            <h1 class="font-serif text-5xl md:text-7xl text-white">Todd Margolis</h1>
            <p class="font-mono text-xs text-gray-400 mt-2">Materializing the Invisible.</p>
            <p class="text-lg text-gray-300 mt-6">A convergence of Creative Practice, Technical Inquiry, and Innovation Strategy.</p>
        </header>
    </section>

    <section class="mt-24">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
            <!-- Pillar 1: Creative -->
            <div class="border border-gray-800 p-8 rounded-lg flex flex-col hover:border-gray-600 transition-colors group">
                <a href="/creative/" class="block">
                    <h1 class="font-mono text-lg uppercase text-white">Creative</h1>
                    <p class="text-gray-400 mt-4 flex-grow">Materializing the invisible. Creating mechanical apparatuses, archival prints, and immersive installations that translate vast, abstract datasets into tangible experiences.</p>
                </a>
                <ul class="mt-6 space-y-2">
                    {creativeSubCategories.map((item) => (
                        <li>
                            <a href={`${item.page}#${slugify(item.name)}`} class="font-mono text-sm text-white hover:text-glow transition-all">{item.name}</a>
                        </li>
                    ))}
                </ul>
            </div>

            <!-- Pillar 2: Inquiry -->
            <div class="border border-gray-800 p-8 rounded-lg flex flex-col hover:border-gray-600 transition-colors group">
                <a href="/inquiry/" class="block">
                    <h1 class="font-mono text-lg uppercase text-white">Inquiry</h1>
                    <p class="text-gray-400 mt-4 flex-grow">Investigating hybrid ecosystems. Designing collaborative environments (Vroom), autostereoscopic systems (Varrier), and spatial interfaces where human intuition and computational logic operate in symbiosis.</p>
                </a>
                <ul class="mt-6 space-y-2">
                    {inquirySubCategories.map((item) => (
                        <li>
                            <a href={`${item.page}#${slugify(item.name)}`} class="font-mono text-sm text-white hover:text-glow transition-all">{item.name}</a>
                        </li>
                    ))}
                </ul>
            </div>

            <!-- Pillar 3: Strategy -->
            <div class="border border-gray-800 p-8 rounded-lg flex flex-col hover:border-gray-600 transition-colors group">
                <a href="/strategy/" class="block">
                    <h1 class="font-mono text-lg uppercase text-white">Strategy</h1>
                    <p class="text-gray-400 mt-4 flex-grow">Architecting the future of R&D. Bridging the gap between "blue sky" academic invention and market-ready reality by designing the physical labs, cross-functional teams, and product roadmaps that make innovation scalable.</p>
                </a>
                <ul class="mt-6 space-y-2">
                    {strategySubCategories.map((item) => (
                        <li>
                            <a href={`${item.page}#${slugify(item.name)}`} class="font-mono text-sm text-white hover:text-glow transition-all">{item.name}</a>
                        </li>
                    ))}
                </ul>
            </div>
        </div>
    </section>

</Layout>
