---
import Layout from '../layouts/Layout.astro';

const slugify = (name: string) =>
  name.replace(/\s*&\s*/g, '-and-').toLowerCase().replace(/\s+/g, '-').replace(/&/g, '-and-').replace(/[^a-z0-9-]/g, '').replace(/-+/g, '-').replace(/^-|-$/g, '');

const creativeSubCategories = [
  { name: 'Tangible Artifacts', page: '/creative/' },
  { name: 'Immersive Installations', page: '/creative/' },
  { name: 'Augmented Interventions', page: '/creative/' },
  { name: 'Performative Systems', page: '/creative/' },
];

const researchSubCategories = [
  { name: 'Display & Interaction', page: '/research/' },
  { name: 'Collaborative Environments', page: '/research/' },
  { name: 'Publications & Theory', page: '/research/' },
  { name: 'Pedagogy & Labs', page: '/research/' },
];

const strategySubCategories = [
  { name: 'R&D Leadership', page: '/strategy/' },
  { name: 'Academic Practice', page: '/strategy/' },
  { name: 'Cultural Stewardship', page: '/strategy/' },
];
---

<Layout title="Todd Margolis" fullTitle="Home | Todd Margolis" description="Materializing the Invisible">

<section class="pt-0 md:pt-10">
  <header class="text-center max-w-4xl mx-auto">
    <h1 class="font-serif text-5xl md:text-7xl text-white">Todd Margolis</h1>
    <p class="font-mono text-xs text-gray-400 mt-4"><i>Materializing the Invisible</i></p>
    <p class="text-lg text-gray-300 mt-10">RESEARCHER / STRATEGIST / ARTIST</p>
  </header>
</section>

    <section class="pt-20 md:pt-16">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-6">
            <!-- Pillar 1: Research -->
            <div class="border border-gray-800 p-8 rounded-lg flex flex-col hover:border-gray-600 transition-colors group m-4">
                <a href="/research/" class="block">
                    <h1 class="font-mono text-lg uppercase text-white">Research</h1>
                    <p class="text-gray-400 mt-4 flex-grow">Examining how communication is meditated and augmented with technology. Designing collaborative environments, autostereoscopic systems and spatial interfaces where human intuition and computational logic operate in symbiosis. Enabling the exploration and critique of emerging media.</p>
                </a>
                <ul class="mt-6 space-y-2">
                    {researchSubCategories.map((item) => (
                        <li>
                            <a href={`${item.page}#${slugify(item.name)}`} class="font-mono text-sm text-white hover:text-glow transition-all">{item.name}</a>
                        </li>
                    ))}
                </ul>
            </div>

            <!-- Pillar 2: Strategy -->
            <div class="border border-gray-800 p-8 rounded-lg flex flex-col hover:border-gray-600 transition-colors group m-4">
                <a href="/strategy/" class="block">
                    <h1 class="font-mono text-lg uppercase text-white">Strategy</h1>
                    <p class="text-gray-400 mt-4 flex-grow">Architecting the future of R&D. Bridging the gap between "blue sky" academic invention and market-ready reality by designing the physical labs, cross-functional teams, and product roadmaps that make innovation scalable.</p>
                </a>
                <ul class="mt-6 space-y-2">
                    {strategySubCategories.map((item) => (
                        <li>
                            <a href={`${item.page}#${slugify(item.name)}`} class="font-mono text-sm text-white hover:text-glow transition-all">{item.name}</a>
                        </li>
                    ))}
                </ul>
            </div>

            <!-- Pillar 3: Creative -->
            <div class="border border-gray-800 p-8 rounded-lg flex flex-col hover:border-gray-600 transition-colors group m-4">
                <a href="/creative/" class="block">
                    <h1 class="font-mono text-lg uppercase text-white">Creative</h1>
                    <p class="text-gray-400 mt-4 flex-grow">An artistic practice centered on the manifestation of data through physical form. By synthesizing traditional sculpture with emergent technologies, I create interactive and immersive environments and artifacts that enable participants to examine the space between the digital record and the sensory world.</p>
                </a>
                <ul class="mt-6 space-y-2">
                    {creativeSubCategories.map((item) => (
                        <li>
                            <a href={`${item.page}#${slugify(item.name)}`} class="font-mono text-sm text-white hover:text-glow transition-all">{item.name}</a>
                        </li>
                    ))}
                </ul>
            </div>

        </div>
    </section>

</Layout>
