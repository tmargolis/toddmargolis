---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Observables" description="Materializing the Invisible">

	<section class="mt-16 md:mt-24">
		<header class="text-center max-w-4xl mx-auto">
			<h1 class="font-serif text-5xl md:text-7xl text-white">Observables</h1>
			<p class="font-mono text-xs text-gray-400 mt-2">Materializing the Invisible.</p>
			<p class="text-lg text-gray-300 mt-6">A convergence of Tangible Informatics, Hybrid Research, and Innovation Strategy.</p>
		</header>
	</section>

	<section class="mt-24">
		<div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
			<!-- Pillar 1: ART -->
			<div class="border border-gray-800 p-8 rounded-lg flex flex-col">
				<h3 class="font-mono text-sm uppercase text-white">Art</h3>
				<h2 class="font-serif text-2xl text-white mt-4">Tangible Informatics & Deep Time</h2>
				<p class="text-gray-400 mt-4 flex-grow">Materializing the invisible. Turning vast, abstract datasets—from cosmic parallax to algorithmic noise—into tangible, mechanical, and physical artifacts that allow us to grasp the scales of space and time.</p>
				<a href="/art" class="mt-6 inline-block font-mono text-sm text-white hover:text-glow transition-all group">
					View Artworks <span class="group-hover:ml-2 transition-all duration-300">&rarr;</span>
				</a>
			</div>

			<!-- Pillar 2: RESEARCH -->
			<div class="border border-gray-800 p-8 rounded-lg flex flex-col">
				<h3 class="font-mono text-sm uppercase text-white">Research</h3>
				<h2 class="font-serif text-2xl text-white mt-4">Situated Interaction & Hybrid Environments</h2>
				<p class="text-gray-400 mt-4 flex-grow">Investigating the "In-Betweens." Designing collaborative environments and autostereoscopic systems where human intuition and computational logic operate in symbiosis.</p>
				<a href="/research" class="mt-6 inline-block font-mono text-sm text-white hover:text-glow transition-all group">
					View Research <span class="group-hover:ml-2 transition-all duration-300">&rarr;</span>
				</a>
			</div>

			<!-- Pillar 3: BUSINESS -->
			<div class="border border-gray-800 p-8 rounded-lg flex flex-col">
				<h3 class="font-mono text-sm uppercase text-white">Business</h3>
				<h2 class="font-serif text-2xl text-white mt-4">Innovation Architecture</h2>
				<p class="text-gray-400 mt-4 flex-grow">Architecting the future of R&D. Bridging the gap between "blue sky" academic inquiry and market-ready reality by designing the physical labs, cross-functional teams, and strategies that make innovation scalable.</p>
				<a href="/strategy" class="mt-6 inline-block font-mono text-sm text-white hover:text-glow transition-all group">
					View Strategy <span class="group-hover:ml-2 transition-all duration-300">&rarr;</span>
				</a>
			</div>
		</div>
	</section>

</Layout>
